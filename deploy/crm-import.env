# Copy to /etc/crm-import.env, chmod 0640, chown root:crmimport.
# Every value here is a default that already lives in the code; override only
# what you actually need to change.

# Lead tables are personal data - keep them out of the code directory.
UPLOAD_DIR=/var/lib/crm-import/uploads

# How long an upload stays available for download, in seconds.
SESSION_TTL_SECONDS=7200

# Concurrent uploads held in RAM. Budget: MAX_SESSIONS x MAX_XLSX_UNCOMPRESSED x ~5.
MAX_SESSIONS=8

# The limit that actually bounds CPU and memory: a .xlsx is a ZIP, and every MB
# of uncompressed sheet XML costs ~0.42 s of CPU and ~5 MB of RAM to parse.
MAX_XLSX_UNCOMPRESSED=25165824

# Secondary sanity limits on the parsed table.
MAX_ROWS=20000
MAX_COLS=100

# Upload size ceiling. Keep nginx's client_max_body_size at the same value,
# otherwise nginx answers with its own HTML 413 and the frontend cannot parse it.
MAX_CONTENT_LENGTH=8388608
